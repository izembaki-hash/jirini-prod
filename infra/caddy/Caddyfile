# إنتاج أحادي المضيف: الواجهة + API خلف نفس الأصل.
# مهم: `/X*` (بدون شرطة) تطابق المسار العاري `/X` والمسارات الفرعية معًا —
# أما `/X/*` فتفوّت المسار العاري فيسقط على الواجهة ويرجع HTML بدل JSON.
#
# نطاقان: jiriny.com (+ www) بشهادة تلقائية Let's Encrypt على :443،
# و blok `:80` يبقى لعنوان IP (وصول تشغيلي بلا TLS + تحدّي ACME).
(jirini-routes) {
    # صفحة عودة الدفع للواجهة — قبل قاعدة /billing* حتى لا تذهب للـAPI
    handle /billing/return* {
        reverse_proxy web:80
    }

    handle /health {
        reverse_proxy api:4000
    }

    handle /tenant {
        reverse_proxy api:4000
    }

    handle /auth* {
        reverse_proxy api:4000
    }

    handle /products* {
        reverse_proxy api:4000
    }

    handle /orders* {
        reverse_proxy api:4000
    }

    handle /customers* {
        reverse_proxy api:4000
    }

    handle /suppliers* {
        reverse_proxy api:4000
    }

    handle /purchases* {
        reverse_proxy api:4000
    }

    handle /shifts* {
        reverse_proxy api:4000
    }

    handle /employees* {
        reverse_proxy api:4000
    }

    handle /attendance* {
        reverse_proxy api:4000
    }

    handle /salary-advances* {
        reverse_proxy api:4000
    }

    handle /salaries* {
        reverse_proxy api:4000
    }

    handle /recipes* {
        reverse_proxy api:4000
    }

    handle /moves* {
        reverse_proxy api:4000
    }

    handle /reports* {
        reverse_proxy api:4000
    }

    handle /branches* {
        reverse_proxy api:4000
    }

    handle /drivers* {
        reverse_proxy api:4000
    }

    handle /alerts* {
        reverse_proxy api:4000
    }

    handle /goals* {
        reverse_proxy api:4000
    }

    handle /wastage* {
        reverse_proxy api:4000
    }

    handle /overheads* {
        reverse_proxy api:4000
    }

    handle /billing* {
        reverse_proxy api:4000
    }

    # `/ops` صفحة SPA — `/ops/*` فقط للـAPI (overview/tenants/support/…)
    handle /ops/* {
        reverse_proxy api:4000
    }

    handle /support* {
        reverse_proxy api:4000
    }

    handle /public* {
        reverse_proxy api:4000
    }

    handle /stream* {
        reverse_proxy api:4000
    }

    handle /upload* {
        reverse_proxy api:4000
    }

    handle {
        reverse_proxy web:80
    }
}

jiriny.com, www.jiriny.com {
    import jirini-routes
}

:80 {
    import jirini-routes
}
