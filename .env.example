# ─── قاعدة البيانات ───
POSTGRES_USER=dz
# أحرف لاتينية وأرقام فقط (تُحقن في DATABASE_URL — تجنب @ : / ؟ #)
# ولّدها بـ: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE-ME-32-chars-minimum-9f8c
POSTGRES_DB=dzsaas
DATABASE_URL=postgresql://dz:غيّرني@localhost:5432/dzsaas?schema=public

# ─── الخلفية ───
PORT=4000
JWT_SECRET=ولّد-قيمة-عشوائية-طويلة-openssl-rand-hex-32
CORS_ORIGIN=https://app.example.dz
UPLOAD_DIR=./uploads

# ─── الفوترة (إنتاج) ───
OPERATOR_KEY=مفتاح-المشغل-السري-لتأكيد-المدفوعات-اليدوية
PAY_CCP=0079999900-clé-XX (يُعلن للزبائن في صفحة الاشتراك)
# SofizPay (CIB/EDAHABIA) — انسخ account التاجر من لوحة sofizpay.com
SOFIZPAY_ACCOUNT=G... (المفتاح العام لحساب التاجر)
# الإنتاج: https://sofizpay.com — التجربة: https://sofizpay.com/sandbox (مع Testing Mode)
SOFIZPAY_BASE=https://sofizpay.com
FRONTEND_URL=https://app.example.dz

# ─── الواجهة (تُحقن وقت البناء) ───
VITE_API_URL=https://api.example.dz
